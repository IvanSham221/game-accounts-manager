PORT=3010
PUBLIC_URL=https://147.45.149.39.sslip.io

# Avito API (Максимальный)
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_USER_ID=

# Shared secret for CRM → inbox API
INBOX_API_KEY=change-me

# Firebase RTDB (same as CRM)
FIREBASE_DATABASE_URL=https://crm-pshub-default-rtdb.europe-west1.firebasedatabase.app
# Optional: if rules require auth, put database secret or ID token
FIREBASE_AUTH=

# Path prefix if reverse-proxied (nginx → /inbox/)
BASE_PATH=/inbox
